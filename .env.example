# Copier en `.env.local` et remplir. Ne jamais committer de valeur réelle.
#
# Seul le formulaire de soumission de projet dépend de ces variables. Sans elles, le site
# fonctionne mais le formulaire affiche un message invitant à écrire directement à l'adresse de
# l'entité active.
#
# Valider la configuration avant de tester le formulaire :
#   pnpm email:test                       connexion + authentification
#   pnpm email:test -- vous@exemple.com   + envoi d'un message d'essai

# --- Serveur d'envoi — IONOS ------------------------------------------------
# Le domaine et la messagerie du client sont chez IONOS. Réglages documentés par IONOS :
#   smtp.ionos.com, port 465 en SSL/TLS ; port 587 en STARTTLS si le 465 est filtré.
#   Le port 25 est bloqué par IONOS, ne pas l'utiliser.
# L'identifiant est l'adresse e-mail COMPLÈTE de la boîte, pas un login abrégé.
SMTP_HOST=smtp.ionos.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# --- Expéditeur -------------------------------------------------------------
# Doit être une boîte qui existe réellement sur le compte IONOS, jamais l'adresse du visiteur :
# IONOS rejette un expéditeur inconnu, et SPF/DMARC feraient tomber le message en indésirables.
# Exemple : Argentum <no-reply@argentuminvestments.ch>
SMTP_FROM=

# Facultatif, mais recommandé ici : les deux entités ont chacune leur domaine chez IONOS.
# Renseigner ces deux lignes fait partir chaque message depuis le domaine de l'entité concernée,
# ce qui aligne l'expéditeur sur la marque affichée. À défaut, SMTP_FROM sert pour les deux.
# Attention : chaque adresse doit être une boîte du compte IONOS, sur son propre domaine.
SMTP_FROM_INVESTMENTS=
SMTP_FROM_ADVISORS=

# --- Destinataire -----------------------------------------------------------
# À laisser VIDE en production : chaque demande part vers l'adresse de l'entité active,
# contact@argentuminvestments.ch ou contact@argentumadvisors.ch selon le site consulté.
#
# Renseigner uniquement pour dérouter tout le trafic vers une seule boîte, en préproduction ou
# pendant les tests, afin de ne pas envoyer de vrais e-mails au client. L'adresse d'origine reste
# indiquée dans le corps du message, sous « Redirigé depuis ».
SMTP_TO=

# --- Validation client ------------------------------------------------------
# Pendant la validation, le site dissuade la copie : clic droit, glisser-déposer, sélection de
# texte et raccourcis d'inspection. Ce n'est pas une protection — voir src/components/CopyGuard.tsx.
# Passer à `off` lors de la mise en ligne, la sélection désactivée gêne un visiteur légitime.
NEXT_PUBLIC_COPY_GUARD=
