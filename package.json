{
  "name": "argentum-investments.ch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "content:extract": "python3 scripts/odt2blocks.py content-source/*.odt > scripts/blocks.json",
    "content:build": "python3 scripts/gen_content.py src/content/fr",
    "check:brand": "node scripts/check-brand-switch.mjs",
    "check:shots": "node scripts/screenshots.mjs .screenshots",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:spec": "python3 scripts/gen_site_spec.py",
    "email:test": "node --env-file-if-exists=.env.local scripts/check-smtp.mjs",
    "check:delivery": "node scripts/check-form-delivery.mjs",
    "images:build": "node scripts/gen_fiche_images.mjs",
    "logos:build": "python3 scripts/gen_logos.py"
  },
  "dependencies": {
    "next": "16.3.1",
    "nodemailer": "^9.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.30.3"
}
